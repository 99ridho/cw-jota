# Event settings, baked into the bundle at build time. None of these are secret.
# Override locally in .env.local (gitignored). Blank values use the defaults in src/config.ts.

# Message played on the Hook screen.
VITE_HOOK_MESSAGE=JOTA
# Station shown on the Finish screen.
VITE_STATION_CALLSIGN=YH0AAJ
VITE_STATION_CTA_EN=Come and try a real radio at the station.
VITE_STATION_CTA_ID=Ayo coba radio sungguhan di stasiun.
# Where the QR code on the Finish screen points.
VITE_PRACTICE_URL=https://lcwo.net
# Printed on the name card.
VITE_EVENT_LABEL=JOTA 2026
# Tone pitch in Hz.
VITE_TONE_HZ=650
# Character/overall speed in WPM (Farnsworth).
VITE_SPEED_LEARN=18/8
VITE_SPEED_CHALLENGE=18/8
# Send drill (tap pad) in each Learn pack. false skips it: Meet, Hear, done.
VITE_SEND_DRILL=false
# GoatCounter endpoint, e.g. https://example.goatcounter.com/count. Blank turns it off.
VITE_ANALYTICS_URL=
